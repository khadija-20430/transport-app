<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/javafx" xmlns="http://javafx.com/javafx"
            fx:controller="transport.control.DisplayListeTitresController"
            stylesheets="@style.css">

    <top>
        <VBox alignment="CENTER" spacing="5" styleClass="header-container">
            <Label text="Liste des Titres de Transport" styleClass="main-title"/>
            <Separator styleClass="separator"/>
        </VBox>
    </top>

    <center>
        <TableView fx:id="titresTable" styleClass="data-table">
            <columns>
                <TableColumn fx:id="colId" text="ID" styleClass="table-column"/>
                <TableColumn fx:id="colDate" text="Date d'achat" styleClass="table-column"/>
                <TableColumn fx:id="colPrix" text="Prix" styleClass="table-column"/>
                <TableColumn fx:id="colType" text="Type" styleClass="table-column"/>
                <TableColumn fx:id="colDetails" text="Détails" styleClass="table-column"/>
                <TableColumn fx:id="colValidite" text="Validité" styleClass="table-column"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="15" styleClass="button-container">

        </HBox>
    </bottom>
</BorderPane>